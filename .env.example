# LiteLLM Proxy Configuration
LITELLM_PORT=4000
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_MASTER_KEY=sk-local-gpu-assistant
LITELLM_MODEL=gpu-assistant

# Ollama Configuration (Local default)
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_PULL=true

# Local SQLite Database Path
SQLITE_PATH=./gpu_assistant.db

# --- Optional upstream LLM configurations ---
# By default, LiteLLM connects to local Ollama.
# If you configure an external upstream (like OpenCode Zen), LiteLLM will attempt it first
# and automatically fall back to local Ollama if it hits rate limits (429) or errors:
#
# LITELLM_UPSTREAM_MODEL=openai/big-pickle
# LITELLM_UPSTREAM_API_BASE=https://opencode.ai/zen/v1
# LITELLM_UPSTREAM_API_KEY=public
# OLLAMA_PULL=true
