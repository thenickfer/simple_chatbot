# ==============================================================================
# GPU Lab Assistant - Environment Configuration
# ==============================================================================

# LiteLLM Proxy Configuration
LITELLM_PORT=4000
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_MASTER_KEY=sk-local-gpu-assistant

# Active Model Alias:
# - "gpu-assistant"       : Default alias (points to local Ollama or configured upstream)
# - "gemini"              : Google Gemini 2.5 Flash Free Tier (requires GEMINI_API_KEY)
# - "groq"                : Groq Llama 3.3 70B (requires GROQ_API_KEY)
# - "openai"              : OpenAI GPT-4o-mini (requires OPENAI_API_KEY)
# - "gpu-assistant-local" : Force direct local Ollama without upstream attempts
LITELLM_MODEL=gpu-assistant

# Ollama Configuration (Local default model)
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_PULL=true

# Local SQLite Database Path
SQLITE_PATH=./gpu_assistant.db

# ==============================================================================
# MODEL CONFIGURATION EXAMPLES / EXEMPLOS DE CONFIGURAÇÃO DE MODELOS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini 2.5 Flash Free Tier (Recommended Cloud Model)
# ------------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/app/apikey
# Zero-config switch: just set GEMINI_API_KEY and LITELLM_MODEL=gemini:
#
# GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here...
# LITELLM_MODEL=gemini
#
# Or configure as the primary upstream for the "gpu-assistant" alias:
# LITELLM_MODEL=gpu-assistant
# LITELLM_UPSTREAM_MODEL=gemini/gemini-2.5-flash
# LITELLM_UPSTREAM_API_KEY=AIzaSy...your_gemini_api_key_here...
# LITELLM_UPSTREAM_API_BASE=

# ------------------------------------------------------------------------------
# 2. Alternative Local Ollama Models (100% Offline & Free)
# ------------------------------------------------------------------------------
# To switch local models, simply change OLLAMA_MODEL and run `make models`:
#
# OLLAMA_MODEL=llama3.2:3b
# # or: OLLAMA_MODEL=mistral:7b
# # or: OLLAMA_MODEL=deepseek-r1:1.5b

# ------------------------------------------------------------------------------
# 3. Groq Free Tier (Ultra-Fast Llama 3.3 70B)
# ------------------------------------------------------------------------------
# Get key at: https://console.groq.com/keys
#
# GROQ_API_KEY=gsk_...
# LITELLM_MODEL=groq

# ------------------------------------------------------------------------------
# 4. OpenAI (GPT-4o-mini)
# ------------------------------------------------------------------------------
# Get key at: https://platform.openai.com/api-keys
#
# OPENAI_API_KEY=sk-...
# LITELLM_MODEL=openai

# ------------------------------------------------------------------------------
# 5. OpenRouter
# ------------------------------------------------------------------------------
# Get key at: https://openrouter.ai/keys
#
# OPENROUTER_API_KEY=sk-or-v1-...
# LITELLM_MODEL=gpu-assistant
# LITELLM_UPSTREAM_MODEL=openrouter/google/gemini-2.5-flash
# LITELLM_UPSTREAM_API_KEY=sk-or-v1-...
# LITELLM_UPSTREAM_API_BASE=
